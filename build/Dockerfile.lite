# Optimized Dockerfile for BuffaLogs Development
# Uses Django runserver (no uWSGI needed for dev)

FROM python:3.12-slim-bookworm

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt/certego/buffalogs

# Copy requirements and install (excluding uwsgi for dev)
COPY buffalogs/requirements.txt /tmp/requirements.txt
RUN grep -v "uwsgi" /tmp/requirements.txt > /tmp/requirements-dev.txt && \
    pip install --no-cache-dir -r /tmp/requirements-dev.txt && \
    rm /tmp/requirements.txt /tmp/requirements-dev.txt

# Copy application code
COPY buffalogs/ .

# Make scripts executable
RUN chmod +x run.sh run_worker.sh run_beat.sh 2>/dev/null || true

# Create logs directory
RUN mkdir -p /var/log && chmod 777 /var/log

# Default command (Django dev server - no uWSGI needed)
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
